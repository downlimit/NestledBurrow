{
  "name": "nestledburrow",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:task": "node scripts/manage-task-preview.mjs start",
    "preview:task:status": "node scripts/manage-task-preview.mjs status",
    "preview:task:stop": "node scripts/manage-task-preview.mjs stop",
    "check": "node scripts/run-project-checks.mjs",
    "check:docs": "node scripts/check-doc-contracts.mjs && node scripts/check-task-identity-contract.mjs",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check:inventory": "node scripts/check-inventory.mjs",
    "check:clock-cycle": "node scripts/check-clock-cycle.mjs",
    "check:needs": "node scripts/check-needs.mjs",
    "check:cooking": "node scripts/check-cooking.mjs",
    "check:guest": "node scripts/check-guest.mjs",
    "check:binary-import": "node scripts/check-binary-import.mjs",
    "check:input": "node scripts/check-input.mjs",
    "check:mobile-camera": "node scripts/check-mobile-camera.mjs",
    "check:movement": "node scripts/check-movement.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check:world": "node scripts/check-world.mjs",
    "check:room-preview": "node scripts/run-python-check.mjs scripts/check-room-preview.py",
    "check:fullscreen": "node scripts/check-fullscreen.mjs",
    "check:hud": "node scripts/check-hud.mjs",
    "check:character": "node scripts/check-character.mjs",
    "check:character-diagonals": "node scripts/run-python-check.mjs scripts/check-character-diagonals.py",
    "check:patrol": "node scripts/check-patrol-contract.mjs",
    "check:runtime-components": "node scripts/check-runtime-components.mjs",
    "check:build-mode": "node scripts/check-build-mode.mjs",
    "check:authoring": "node scripts/check-authoring.mjs",
    "check:task-043": "node scripts/check-task-043.mjs",
    "check:task-044": "node scripts/check-task-044.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "check:facilities": "node scripts/check-facilities.mjs",
    "check:interaction": "node scripts/check-interaction.mjs",
    "check:dialogue": "node scripts/check-dialogue.mjs",
    "i18n:status": "i18next-cli status",
    "i18n:lint": "i18next-cli lint",
    "check:i18n": "node scripts/check-localization.mjs && npm run i18n:status && npm run i18n:lint",
    "check:progress": "node scripts/check-progress.mjs",
    "check:e2e": "playwright test",
    "check:e2e:focused": "node scripts/run-focused-e2e.mjs",
    "check:text-resolution": "node scripts/check-text-resolution.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.2.7",
    "phaser": "4.2.1",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "i18next-icu": "^2.4.1"
  },
  "devDependencies": {
    "vite": "8.1.5",
    "i18next-cli": "^1.5.0",
    "@playwright/test": "1.54.2"
  }
}
